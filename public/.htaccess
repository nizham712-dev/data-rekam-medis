# ---------------------------------------------------------------
# React Router (BrowserRouter) - SPA fallback untuk Apache/cPanel
# Letakkan file ini di folder publik tempat file index.html diupload.
# Jika aplikasi berada di subdirektori, sesuaikan RewriteBase bila
# rewrite rule di bawah tidak bekerja.
# ---------------------------------------------------------------
Options -MultiViews
RewriteEngine On

# Jangan tulis ulang file/direktori yang benar-benar ada (aset, dll.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Semua rute lain -> index.html
RewriteRule . index.html [L]

# Keamanan dasar
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache aset build (Vite memberi hash pada nama file aset)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
